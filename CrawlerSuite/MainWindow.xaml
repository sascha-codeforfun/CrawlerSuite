<Window x:Class="CrawlerSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:busy="clr-namespace:BusyOverlayKit"
        xmlns:views="clr-namespace:CrawlerSuite.Views"
        Style="{StaticResource Hue.Window}"
        Title="Crawler Suite"
        Width="1320" Height="880" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- header -->
            <RowDefinition Height="*" />     <!-- body   -->
            <RowDefinition Height="Auto" />  <!-- status -->
        </Grid.RowDefinitions>

        <!-- Header: icon, name, one line on what it does; version on the right. -->
        <Border Grid.Row="0" Style="{StaticResource Hue.Header}">
            <Grid x:Name="HeaderGrid" SizeChanged="OnHeaderLayoutChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl Style="{StaticResource Hue.IconGlow}" Width="64" Height="64">
                    <Image Source="/app_256.png" RenderOptions.BitmapScalingMode="HighQuality" />
                </ContentControl>
                <StackPanel x:Name="TitlePanel" Grid.Column="1" Margin="18,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="Crawler Suite" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="Crawls your own site and reports spelling, content-quality and link defects for triage"
                               Style="{StaticResource Text.Body}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <!-- Screen mask for screenshots and shared screens: one click, not stored, Clear at every start. -->
                <!-- The run's wall clocks: Crawl, Analysis and their sum; amber while a run goes, kept afterwards.
                     Centred in the header (placed from code: OnHeaderLayoutChanged keeps them clear of the
                     title and the screen-mask buttons). -->
                <StackPanel x:Name="ClocksPanel" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Visibility="{Binding Visible, Converter={StaticResource BoolToVis}}"
                            SizeChanged="OnHeaderLayoutChanged" IsVisibleChanged="OnClocksVisibleChanged"
                            AutomationProperties.Name="Run clocks">
                    <StackPanel.Resources>
                        <Style x:Key="ClockPill" TargetType="ContentControl" BasedOn="{StaticResource Hue.Pill}">
                            <Setter Property="Margin" Value="0,0,8,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.WarnText}" />
                                    <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarnEdge}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>
                    <ContentControl Style="{StaticResource ClockPill}" ToolTip="Connectivity check, crawl and extra download">
                        <TextBlock Text="{Binding CrawlText}" FontFamily="{StaticResource Font.Mono}" />
                    </ContentControl>
                    <ContentControl Style="{StaticResource ClockPill}" ToolTip="Every phase after the crawl: prepare, analysis, spell-check, output, dictionaries">
                        <TextBlock Text="{Binding AnalysisText}" FontFamily="{StaticResource Font.Mono}" />
                    </ContentControl>
                    <ContentControl Style="{StaticResource ClockPill}" Margin="0" ToolTip="Crawl and analysis together; time waiting for your answers is not counted">
                        <TextBlock Text="{Binding TotalText}" FontFamily="{StaticResource Font.Mono}" />
                    </ContentControl>
                </StackPanel>
                <StackPanel x:Name="MaskPanel" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,32,0">
                    <TextBlock Text="SCREEN MASK" Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" AutomationProperties.Name="Screen mask">
                        <RadioButton GroupName="Mask" Tag="Clear" Content="Clear" IsChecked="True" Checked="OnMaskChecked"
                                     Style="{StaticResource {x:Type ToggleButton}}"
                                     ToolTip="Everything in clear text" />
                        <RadioButton GroupName="Mask" Tag="Host" Content="Host" Checked="OnMaskChecked" Margin="6,0,0,0"
                                     Style="{StaticResource {x:Type ToggleButton}}"
                                     ToolTip="https://•••••/en/products/widget.html — site names, folders and the proxy are hidden too" />
                        <RadioButton GroupName="Mask" Tag="HostAndPath" Content="Host + path" Checked="OnMaskChecked" Margin="6,0,0,0"
                                     Style="{StaticResource {x:Type ToggleButton}}"
                                     ToolTip="https://•••••/•••/•••/widget.html — site names, folders and the proxy are hidden too" />
                        <RadioButton GroupName="Mask" Tag="SchemeOnly" Content="Scheme only" Checked="OnMaskChecked" Margin="6,0,0,0"
                                     Style="{StaticResource {x:Type ToggleButton}}"
                                     ToolTip="https://••••• — site names, folders and the proxy are hidden too" />
                    </StackPanel>
                </StackPanel>
                <!-- Settings: a page of the navigation, opened from the header. The hidden caption keeps
                     the gear level with the screen-mask buttons. -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,32,0">
                    <TextBlock Text="SETTINGS" Style="{StaticResource Text.Section}" Margin="0,0,0,6" Visibility="Hidden" />
                    <RadioButton x:Name="NavSettings" GroupName="Nav" Checked="OnNavChecked"
                                 Style="{StaticResource {x:Type ToggleButton}}" Content="&#xE713;"
                                 FontFamily="Segoe MDL2 Assets" FontSize="16" MinWidth="44"
                                 ToolTip="Settings" AutomationProperties.Name="Settings" />
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="VersionText" Style="{StaticResource Text.Heading}" HorizontalAlignment="Right" />
                    <TextBlock x:Name="SdkText" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                    <TextBlock x:Name="RuntimeText" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: side navigation and the current page. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Brush.Chrome}"
                    BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,20,12,12">
                    <!-- The site scope: every page follows it; a running crawl locks it. -->
                    <StackPanel x:Name="ScopePanel" Margin="0,0,0,18">
                        <TextBlock Text="SITE" Style="{StaticResource Text.Section}" Margin="2,0,0,6" />
                        <ComboBox ItemsSource="{Binding Sites}" SelectedItem="{Binding SelectedSite}"
                                  IsEnabled="{Binding CanChangeSite}" AutomationProperties.Name="Site"
                                  ToolTip="The site every page works on. Locked while a crawl runs.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{views:Masked}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <RadioButton x:Name="NavRun" Style="{StaticResource Hue.NavItem}" GroupName="Nav"
                                 Content="Crawl" IsChecked="True" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavDictionaries" Style="{StaticResource Hue.NavItem}" GroupName="Nav"
                                 Content="Dictionaries" Checked="OnNavChecked" Margin="0,4,0,0" />
                    <RadioButton x:Name="NavSpell" Style="{StaticResource Hue.NavItem}" GroupName="Nav"
                                 Content="Spell findings" Checked="OnNavChecked" Margin="0,4,0,0" />
                    <RadioButton x:Name="NavResults" Style="{StaticResource Hue.NavItem}" GroupName="Nav"
                                 Content="Results" Checked="OnNavChecked" Margin="0,4,0,0" />
                    <RadioButton x:Name="NavTriage" Style="{StaticResource Hue.NavItem}" GroupName="Nav"
                                 Content="Triage" Checked="OnNavChecked" Margin="0,4,0,0" />
                    <RadioButton x:Name="NavFormats" Style="{StaticResource Hue.NavItem}" GroupName="Nav"
                                 Content="Output files" Checked="OnNavChecked" Margin="0,4,0,0" />
                    <!-- Apart from the run's pages: an inspection of two snapshots' saved files. -->
                    <Border Style="{StaticResource Hue.Divider}" Width="Auto" Height="1" Margin="2,18,2,14" />
                    <RadioButton x:Name="NavComparison" Style="{StaticResource Hue.NavItem}" GroupName="Nav"
                                 Content="Comparison" Checked="OnNavChecked" />
                </StackPanel>
            </Border>

            <ContentControl Grid.Column="1" x:Name="PageHost" Focusable="False" />
        </Grid>

        <!-- Status bar. -->
        <Border Grid.Row="2" Style="{StaticResource Hue.StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl x:Name="StatusDot" Style="{StaticResource Hue.Marker}"
                                    Foreground="{DynamicResource Brush.Ok}" />
                    <TextBlock x:Name="StatusText" Text="Ready" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Hue.Button.Ghost}" Content="Program folder"
                            Click="OnOpenProgramFolder" ToolTip="Open the folder with the program, its configuration and application.log" />
                    <Button Style="{StaticResource Hue.Button.Ghost}" Content="Application log" Margin="6,0,0,0"
                            Click="OnOpenLog" ToolTip="Open application.log" />
                </StackPanel>
            </Grid>
        </Border>

        <busy:BusyOverlay x:Name="Busy" Grid.RowSpan="3" AnimateOverride="True" />
    </Grid>
</Window>
