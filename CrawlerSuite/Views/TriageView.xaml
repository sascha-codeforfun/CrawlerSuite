<UserControl x:Class="CrawlerSuite.Views.TriageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CrawlerSuite.Views"
             xmlns:hue="clr-namespace:HueThemeKit"
             views:UrlDisplay.Root="{Binding SiteRoot}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:InverseBoolToVisibility x:Key="InverseBoolToVis" />
        <views:TextToVisibility x:Key="TextToVis" />

        <!-- A filter chip above the page list: the chip itself, dimmed while it filters its pages out. -->
        <Style x:Key="PartChip" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- As on the Spell findings page. The template draws its own frame: the text takes the theme's colour, not the system default. -->
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Frame" Padding="8,2" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource Brush.Accent}" Background="Transparent"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <!-- The app's filter chip: a click lights it and shows only its pages; lit frame; the others of the group dimmed. -->
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Click to show only these pages; click again to show all" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Frame" Background="Transparent" CornerRadius="11" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.4" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="FilterChipTemplate">
            <ToggleButton Style="{StaticResource FilterChip}" IsChecked="{Binding IsOn, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding Text}">
                <ContentControl Content="{Binding Text}" Style="{Binding Role, Converter={x:Static views:RoleToChipStyle.Instance}}" />
            </ToggleButton>
        </DataTemplate>

        <!-- One item to decide: where it is, what it is, the context with its marks, and the verdict. -->
        <DataTemplate x:Key="ItemTemplate">
            <StackPanel>
            <!-- The explanation of this kind of defect: on the first item of its kind on the page, folded to one line. -->
            <views:BasisCard Card="{Binding Card}" Margin="0,0,0,8" />
            <!-- An intended other language still needs language markup: shown on the first Locale item of the page. -->
            <views:BasisCard Card="{Binding LocaleCard}" Margin="0,0,0,8" />
            <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource Brush.Raised}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUndecided}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Content="Security" Style="{StaticResource Hue.Pill.Error}" Margin="0,0,8,0" VerticalAlignment="Center"
                                            ToolTip="From a pattern group marked security-relevant in Settings"
                                            Visibility="{Binding IsSecurity, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            <!-- Spelling: other dictionaries that know the word. Information only. -->
                            <ContentControl Content="{Binding ValidInText}" Style="{StaticResource Hue.Tag.Accent}" Margin="8,0,0,0" VerticalAlignment="Center"
                                            ToolTip="Another dictionary knows this word. Information only: it stays flagged for the page language."
                                            Visibility="{Binding HasValidIn, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <views:CodeCell Value="{Binding Detail}" Margin="0,4,0,0" />
                        <views:QualityContextCell Value="{Binding Context}" IssueType="{Binding Type}" Detail="{Binding Detail}" Margin="0,8,0,0" />
                        <!-- A space at a hyphen that is part of a name: kept as a proper name by a click, as the finding has it. -->
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsName, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="A name written this way on purpose? Keep it as a proper name, exactly as written:" Style="{StaticResource Text.Caption}" />
                            <WrapPanel Margin="0,6,0,0">
                                <ToggleButton Style="{StaticResource PartChip}" IsChecked="{Binding IncludeExtra, Mode=TwoWay}"
                                              IsEnabled="{Binding CanKeep}" ToolTip="Part of the name? Click to leave it out"
                                              AutomationProperties.Name="{Binding NameExtra}"
                                              Visibility="{Binding HasExtraBefore, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding NameExtra}" FontFamily="{StaticResource Font.Mono}" FontSize="14"
                                               Foreground="{DynamicResource Brush.Text}" />
                                </ToggleButton>
                                <TextBlock Text="{Binding NameCore}" FontFamily="{StaticResource Font.Mono}" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ToggleButton Style="{StaticResource PartChip}" IsChecked="{Binding IncludeExtra, Mode=TwoWay}"
                                              IsEnabled="{Binding CanKeep}" ToolTip="Part of the name? Click to leave it out"
                                              AutomationProperties.Name="{Binding NameExtra}"
                                              Visibility="{Binding HasExtraAfter, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding NameExtra}" FontFamily="{StaticResource Font.Mono}" FontSize="14"
                                               Foreground="{DynamicResource Brush.Text}" />
                                </ToggleButton>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding CanKeep, Converter={StaticResource BoolToVis}}">
                                <Button Content="Add to proper names" Style="{StaticResource Hue.Button.Tonal}" Click="OnKeepName"
                                        ToolTip="Adds the phrase to Proper names in the settings (Spelling); an acronym can be added there" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsKept, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding KeptText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                <Button Content="Undo" Style="{StaticResource Hue.Button.Outline}" Margin="10,0,0,0" MinWidth="70" Click="OnUndoName"
                                        Visibility="{Binding CanUndoName, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Removes the phrase this click added" />
                            </StackPanel>
                            <TextBlock Text="{views:Masked NameNotice}" Foreground="{DynamicResource Brush.ErrorText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding NameNotice, Converter={StaticResource TextToVis}}" />
                        </StackPanel>
                        <!-- Why it is not fixed: only for Wontfix, and folded until wanted — the verdict often speaks for itself. -->
                        <Button Content="Add a comment" Style="{StaticResource Hue.Button.Ghost}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Click="OnAddComment" ToolTip="Say why it is not fixed (optional)"
                                Visibility="{Binding ShowsAddComment, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowsCommentBox, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Comment (optional)" Style="{StaticResource Text.Caption}" />
                            <TextBox Text="{Binding Comment, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0" MaxWidth="700"
                                     HorizontalAlignment="Left" MinWidth="420" IsEnabled="{Binding IsEditable}"
                                     AutomationProperties.Name="Why it is not fixed" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" MinWidth="250">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ToggleButton Content="Ticket" IsChecked="{Binding IsTicket, Mode=TwoWay}" IsEnabled="{Binding CanDecide}"
                                          MinWidth="76" ToolTip="Goes into this page's ticket" />
                            <ToggleButton Content="Wontfix" IsChecked="{Binding IsWontfix, Mode=TwoWay}" IsEnabled="{Binding CanDecide}"
                                          MinWidth="76" Margin="6,0,0,0" ToolTip="Not fixed — on this page only. Also the way out when there is no clear verdict." />
                            <ToggleButton Content="Locale" IsChecked="{Binding IsLocale, Mode=TwoWay}" IsEnabled="{Binding CanDecide}"
                                          MinWidth="76" Margin="6,0,0,0" ToolTip="An intentional language choice"
                                          Visibility="{Binding AllowsLocale, Converter={StaticResource BoolToVis}}" />
                            <!-- The word is right: into a dictionary, for every page (the same choice as on Spell findings). Apart from the verdicts: it reaches beyond this page. -->
                            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Visibility="{Binding ShowsDictionaryButtons, Converter={StaticResource BoolToVis}}">
                                <Button Content="User" Style="{StaticResource Hue.Button.Tonal}" MinWidth="64" Click="OnAddUser" IsEnabled="{Binding CanAddUser}"
                                        ToolTip="The word is right, for every site: added to the user dictionary. Every page's item of it is set aside; gone on the next run." />
                                <Button Content="Site" Style="{StaticResource Hue.Button.Tonal}" MinWidth="64" Margin="6,0,0,0" Click="OnAddSite" IsEnabled="{Binding CanAddSite}"
                                        ToolTip="The word is right for this site: added to its dictionary. Every page's item of it is set aside; gone on the next run." />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"
                                    Visibility="{Binding IsInDictionary, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding DictionaryText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.OkText}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                            <Button Content="Undo" Style="{StaticResource Hue.Button.Outline}" Margin="10,0,0,0" MinWidth="70" Click="OnUndoDictionary"
                                    IsEnabled="{Binding IsEditable}" ToolTip="Takes the word out of the dictionary again: its items come back on every page." />
                        </StackPanel>
                        <TextBlock Text="{Binding DictionaryNotice}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.ErrorText}"
                                   HorizontalAlignment="Right" TextWrapping="Wrap" MaxWidth="420" Margin="0,4,0,0"
                                   Visibility="{Binding DictionaryNotice, Converter={StaticResource TextToVis}}" />
                        <TextBlock Text="{Binding StateText}" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUndecided}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.WarnText}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFiled}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.OkText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Spelling: the other pages with the word, so a call can be made with all of them in view. -->
                        <Button Content="{Binding OtherPagesText}" Style="{StaticResource Hue.Button.Ghost}" HorizontalAlignment="Right"
                                Margin="0,4,0,0" Click="OnOtherPages"
                                Visibility="{Binding HasOtherPages, Converter={StaticResource BoolToVis}}"
                                ToolTip="Back to the list, searched for this word: every page that has it as a finding" />
                        <TextBlock Text="{Binding OnlyHereText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" Margin="0,4,0,0"
                                   Visibility="{Binding OnlyHereText, Converter={StaticResource TextToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" Padding="28,24" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel>
                <!-- Structure only: no address, finding text or excerpt goes into the copy. -->
                <!-- Debug mode only: every page as a ticket PDF, checked, into the debug folder. The ledger is not touched. -->
                <Button DockPanel.Dock="Right" Content="Ticket sweep" Style="{StaticResource Hue.Button.Outline}" Margin="8,0,0,0"
                        VerticalAlignment="Center" Click="OnTicketSweep"
                        Visibility="{Binding CanSweep, Converter={StaticResource BoolToVis}}"
                        ToolTip="Debug mode: every page as a ticket with all its items, written as PDF with its text into the debug folder and checked (sweep.md). Verdicts are made in memory only: the triage ledger is not touched." />
                <Button x:Name="CopyForAiButton" DockPanel.Dock="Right" Content="Copy for AI" Style="{StaticResource Hue.Button.Tonal}"
                        VerticalAlignment="Center" Click="OnCopyForAi"
                        Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVis}}"
                        ToolTip="Copies what triage shows — switches, counts, the open page's kinds and verdicts — without addresses, finding texts or excerpts" />
                <TextBlock Text="{views:Masked Heading}" Style="{StaticResource Text.Title}" />
            </DockPanel>
            <TextBlock Text="{views:Masked SnapshotPath}" Style="{StaticResource Text.Mono}" Margin="0,6,0,0"
                       Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVis}}" />

            <ContentControl Style="{StaticResource Hue.Callout.Warn}" Margin="0,14,0,0"
                            Visibility="{Binding Notice, Converter={StaticResource TextToVis}}">
                <TextBlock Text="{views:Masked Notice}" TextWrapping="Wrap" />
            </ContentControl>

            <!-- Bidi controls: named first, on every view of triage. -->
            <ContentControl Style="{StaticResource Hue.Callout.Critical}" Margin="0,14,0,0"
                            Visibility="{Binding HasBidi, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Bidi controls found — check these pages now" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="An override or embedding can make a page read differently from what is stored. Look at each one before anything else."
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding BidiPages}" Margin="0,8,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6,0,0">
                                    <views:UrlCell Value="{Binding Url}" HorizontalAlignment="Left" />
                                    <views:CodeCell Value="{Binding Detail}" Margin="0,2,0,0" />
                                    <views:QualityContextCell Value="{Binding Context}" IssueType="{Binding Type}" Detail="{Binding Detail}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>

            <!-- ═══ The list ═══ -->
            <StackPanel Visibility="{Binding IsPageOpen, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVis}}">

                    <!-- What triage counts: set in Settings → Triage, shown here only. -->
                    <Border Margin="0,16,0,0" Padding="12,8" CornerRadius="8" BorderThickness="1"
                            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.LineSoft}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Change in Settings" Style="{StaticResource Hue.Button.Outline}"
                                    VerticalAlignment="Center" Margin="12,0,0,0" Click="OnOpenTriageSettings" />
                            <StackPanel>
                                <TextBlock Text="WHAT TRIAGE COUNTS" Style="{StaticResource Text.Section}" />
                                <TextBlock Text="{Binding FilterSummary}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- The pages. -->
                    <Border Style="{StaticResource Hue.Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PAGES WITH DEFECTS" Style="{StaticResource Text.Section}" />
                                    <TextBlock Text="{Binding ListSummary}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Grid Grid.Column="1" Width="340" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <!-- The search applies once typing pauses (Delay), or at once on Enter. -->
                                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}" Padding="10,6,34,6"
                                             VerticalContentAlignment="Center" KeyDown="OnSearchKeyDown" AutomationProperties.Name="Find a page"
                                             ToolTip="Shows the pages whose address contains the text, or that have it as a flagged word (the whole word), ignoring case, with the lit chips. Enter searches at once, Esc clears." />
                                    <TextBlock Text="Find a page by its address or a flagged word" Margin="13,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="✕" Style="{StaticResource Hue.Button.Ghost}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Padding="8,2" Margin="0,0,4,0" Click="OnClearSearch" ToolTip="Clear the search"
                                            Visibility="{Binding SearchActive, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Grid>
                            <!-- Filters: lit chips are shown. Source chips (as in the table) only when the content list knows the pages. -->
                            <WrapPanel Margin="0,10,0,0">
                                <ItemsControl ItemsSource="{Binding SourceChips}" ItemTemplate="{StaticResource FilterChipTemplate}" Focusable="False"
                                              Margin="0,0,16,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding DecisionChips}" ItemTemplate="{StaticResource FilterChipTemplate}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </WrapPanel>
                            <!-- Changes wait here until asked for, so the list never moves while pages are compared. -->
                            <ContentControl Style="{StaticResource Hue.Callout}" Margin="0,10,0,0"
                                            Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Update list" Style="{StaticResource Hue.Button.Tonal}" Margin="12,0,0,0"
                                            Click="OnUpdateList" />
                                </Grid>
                            </ContentControl>
                            <DataGrid x:Name="PageGrid" ItemsSource="{Binding Pages}" Style="{StaticResource Hue.DataGrid.Compact}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                                      SelectionMode="Single" Margin="0,10,0,0" RowHeight="NaN" MinRowHeight="42" MouseDoubleClick="OnPageDoubleClick" PreviewKeyDown="OnPageKeyDown"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnPassWheelToPage"
                                      AutomationProperties.Name="Pages with defects">
                                <DataGrid.Columns>
                                    <!-- Security / bidi badges: shown only when a page has one (see ShowBadgeColumn). -->
                                    <DataGridTemplateColumn x:Name="BadgeColumn" Header="" Width="78" SortMemberPath="HasBidi" Visibility="Collapsed">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Left">
                                                    <ContentControl Content="security" Style="{StaticResource Hue.Pill.Error}" HorizontalAlignment="Left"
                                                                    Visibility="{Binding HasSecurity, Converter={StaticResource BoolToVis}}" />
                                                    <ContentControl Content="bidi" Style="{StaticResource Hue.Pill.Error}" HorizontalAlignment="Left"
                                                                    Visibility="{Binding HasBidi, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- The page's source from the CMS content list, as the export has it; shown when any page has one. -->
                                    <DataGridTemplateColumn x:Name="SourceColumn" Header="Source" Width="Auto" MinWidth="140" SortMemberPath="SourceText" Visibility="Collapsed">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <views:SourceCell Text="{Binding SourceText}" Link="{Binding CmsLink}" Role="{Binding SourceRole}" Address="{Binding NoSourceAddress}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Page" Width="2*" SortMemberPath="Url">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <views:UrlCell Value="{Binding Url}" Margin="0,4,0,4" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Defects" Binding="{Binding CountText}" SortMemberPath="Count" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right" />
                                                <Setter Property="Margin" Value="0,0,10,0" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="By family" Binding="{Binding Families}" Width="2*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Ride-along" Binding="{Binding RideAlong}" Width="110" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" SortMemberPath="Status" Width="110" />
                                    <DataGridTextColumn Header="Tickets" Binding="{views:Masked Tickets}" SortMemberPath="Tickets" Width="*" />
                                    <DataGridTemplateColumn Header="" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Open" Style="{StaticResource Hue.Button.Tonal}" Click="OnOpenPage" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ═══ One page ═══ -->
            <StackPanel DataContext="{Binding Page}" Margin="0,16,0,0"
                        Visibility="{Binding DataContext.IsPageOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="← All pages" Style="{StaticResource Hue.Button.Outline}" Click="OnBack" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="16,0,16,0">
                        <!-- Left-aligned: the copy button sits right after the address, not at the far end of the row. -->
                        <views:UrlCell Value="{Binding Url}" HorizontalAlignment="Left" />
                        <views:SourceCell Text="{Binding SourceText}" Link="{Binding CmsLink}" Role="{Binding SourceRole}" Address="{Binding NoSourceAddress}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding DecisionSummary}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Next page →" Style="{StaticResource Hue.Button.Outline}" Click="OnNext" VerticalAlignment="Top" />
                </Grid>

                <!-- Search appearance: the page as a search result would likely show it (desktop, estimated). -->
                <Border Style="{StaticResource Hue.Card}" Margin="0,14,0,0"
                        Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="SEARCH RESULT PREVIEW" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="As a desktop search result would likely show this page: cut with … where it would likely be cut. An estimate from the letter widths; a search engine may also rewrite title or description."
                                   Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <!-- The result itself on a dim cream, like a page of results, so it stands out from the dark
                             card without glaring; its own colours, not the theme's (all at least 4.5:1 on the cream). -->
                        <Border Background="#C4BFB4" BorderBrush="#A8A296" BorderThickness="1"
                                CornerRadius="6" Padding="14,10" Margin="0,10,0,0" MaxWidth="660" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="{Binding Snippet.Url}" FontSize="12" Foreground="#4A4D50" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SnippetTitle}" FontFamily="Arial" FontSize="20" Foreground="#1A0DAB"
                                           TextWrapping="NoWrap" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding SnippetDescription}" FontFamily="Arial" FontSize="14" Foreground="#3A3A3A"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Ticket numbers: typed in once the tickets exist upstream. -->
                <Border Style="{StaticResource Hue.Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="TICKET NUMBERS" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="Type them in once the tickets exist in your ticket system — several separated by commas."
                                   Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBox Text="{Binding TicketsText, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0" MinWidth="320" MaxWidth="640"
                                 HorizontalAlignment="Left" IsEnabled="{Binding IsEditable}" AutomationProperties.Name="Ticket numbers" />
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="DEFECTS ON THIS PAGE" Style="{StaticResource Text.Section}" Margin="0,18,0,8" />
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemTemplate}" Focusable="False" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasRideAlong, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="RIDE-ALONG" Style="{StaticResource Text.Section}" Margin="0,10,0,2" />
                    <TextBlock Text="These go into this page's ticket with the defects above; on their own they never list a page."
                               Style="{StaticResource Text.Caption}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding RideAlong}" ItemTemplate="{StaticResource ItemTemplate}" Focusable="False" />
                </StackPanel>

                <!-- Broken links (log 07): one item per broken address, most serious reach first. -->
                <StackPanel Visibility="{Binding HasBrokenLinks, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="BROKEN LINKS" Style="{StaticResource Text.Section}" Margin="0,18,0,2" />
                    <TextBlock Text="Each item names its reach — who runs into it — and how to see the 404 in a browser where the snapshot alone cannot prove it."
                               Style="{StaticResource Text.Caption}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding BrokenLinks}" ItemTemplate="{StaticResource ItemTemplate}" Focusable="False" />
                </StackPanel>

                <!-- Spelling last: it waits until the content quality above is decided. -->
                <StackPanel Visibility="{Binding HasSpelling, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="SPELLING" Style="{StaticResource Text.Section}" Margin="0,18,0,2" />
                    <TextBlock Text="Unlocked once the content quality above is decided: a verdict there can change what counts as a spelling error."
                               Style="{StaticResource Text.Caption}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding SpellingWaits, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Spelling}" ItemTemplate="{StaticResource ItemTemplate}" Focusable="False" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Filing: once every item has a verdict. -->
                <Border Style="{StaticResource Hue.Card}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DecisionSummary}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Ticket files the page once every item has a verdict: Ticket items go into the ticket, every verdict is recorded."
                                       Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- On demand only: the page's ticket document, previewed before it is saved. -->
                            <Button Content="Ticket document…" Style="{StaticResource Hue.Button.Tonal}" MinWidth="150" Margin="0,0,10,0"
                                    IsEnabled="{Binding CanMakeDocument}" Click="OnTicketDocument"
                                    ToolTip="A document of this page's Ticket and Locale items with their explanations, to attach to the ticket. Preview first, then PDF or XPS."
                                    ToolTipService.ShowOnDisabled="True" />
                            <Button Content="{Binding FileButtonText}" Style="{StaticResource Hue.Button.Primary}"
                                    MinWidth="140" IsEnabled="{Binding CanFile}" Click="OnFile" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
