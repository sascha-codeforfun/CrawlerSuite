<UserControl x:Class="CrawlerSuite.Views.ComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CrawlerSuite.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:TextToVisibility x:Key="TextToVis" />

        <!-- A filter chip: a click lights it (a bright edge) and shows its files; the others of its group dim. -->
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Click to show these files; click again to show all" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Frame" Background="Transparent" CornerRadius="11" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.4" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="FilterChipTemplate">
            <ToggleButton Style="{StaticResource FilterChip}" IsChecked="{Binding IsOn, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}"
                          Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <ContentControl Content="{Binding Text}" Style="{Binding Style, Converter={x:Static views:HueStyle.Instance}}" />
            </ToggleButton>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- A snapshot's date: year and time as they are, the month cyan, the day amber — what tells two snapshots apart. -->
        <DataTemplate x:Key="SnapshotDate">
            <TextBlock>
                <Run Text="{Binding Year, Mode=OneWay}" /><Run Text="-" /><Run Text="{Binding Month, Mode=OneWay}" Foreground="{DynamicResource Brush.AccentText}" /><Run Text="-" /><Run Text="{Binding Day, Mode=OneWay}" Foreground="{DynamicResource Brush.WarnText}" /><Run Text=" " /><Run Text="{Binding Time, Mode=OneWay}" /><Run Text="{Binding Latest, Mode=OneWay}" Foreground="{DynamicResource Brush.TextDim}" />
            </TextBlock>
        </DataTemplate>

        <!-- Behind a picture: a checkerboard, so its transparent parts show as such. -->
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF2A2E35" Geometry="M0,0 H2 V2 H0Z" />
                    <GeometryDrawing Brush="#FF383D46" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- A picture a line carries as base64: said so, then drawn at its own size (smaller only to fit); an SVG as its text. -->
        <DataTemplate x:Key="EmbeddedPicture">
            <Border Background="{DynamicResource Brush.Raised}" BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="1"
                    CornerRadius="4" Padding="8,6" Margin="0,6,0,0" HorizontalAlignment="Stretch">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open…" Style="{StaticResource Hue.Button.Ghost}" Click="OnOpenPicture" Margin="8,0,0,0"
                                FontFamily="{StaticResource Font.Ui}" ToolTip="Opens the picture in a window: full size, fitted, or saved as it stands in the source." />
                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Font.Ui}" Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Note}" FontFamily="{StaticResource Font.Ui}" Foreground="{DynamicResource Brush.AccentText}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding Note, Converter={StaticResource TextToVis}}" />
                    <TextBlock Text="{Binding Problem}" FontFamily="{StaticResource Font.Ui}" Foreground="{DynamicResource Brush.WarnText}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding Problem, Converter={StaticResource TextToVis}}" />
                    <!-- Fitted to the list: never wider than the cell, never taller than the list, never enlarged; a click opens it whole. -->
                    <Button Click="OnOpenPicture" HorizontalAlignment="Left" Margin="0,6,0,0" Cursor="Hand" Focusable="True"
                            AutomationProperties.Name="{Binding Label}" ToolTip="Click: open at full size"
                            Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource Checker}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Image Source="{Binding Image}" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality"
                               MaxWidth="{Binding PixelWidth}"
                               MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={x:Static views:LessBy.Instance}, ConverterParameter=110}" />
                    </Button>
                    <TextBlock Text="{Binding SvgText}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasSvg, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- A picture: fitted to its side (never enlarged), or at its own pixels with scroll bars. -->
        <Style x:Key="PictureScroll" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualSize}" Value="True">
                    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PictureA" TargetType="Image">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="DownOnly" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualSize}" Value="True">
                    <Setter Property="Stretch" Value="Fill" />
                    <Setter Property="Width" Value="{Binding PictureWidthA}" />
                    <Setter Property="Height" Value="{Binding PictureHeightA}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PictureB" TargetType="Image" BasedOn="{StaticResource PictureA}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualSize}" Value="True">
                    <Setter Property="Stretch" Value="Fill" />
                    <Setter Property="Width" Value="{Binding PictureWidthB}" />
                    <Setter Property="Height" Value="{Binding PictureHeightB}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A row of the side-by-side view: no selection, no hover; the cells carry the colours. -->
        <Style x:Key="DiffRow" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CellA" TargetType="Border">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Changed">
                    <Setter Property="Background" Value="{DynamicResource Brush.ErrorSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="OnlyA">
                    <Setter Property="Background" Value="{DynamicResource Brush.ErrorSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellB" TargetType="Border">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Changed">
                    <Setter Property="Background" Value="{DynamicResource Brush.OkSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="OnlyB">
                    <Setter Property="Background" Value="{DynamicResource Brush.OkSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LineNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="0,1,6,1" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Heading. -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Comparison" Style="{StaticResource Text.Title}" />
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="The saved files of two snapshots of the site, A and B, compared file by file — every difference counts, blanks and line ends included; on pages compared as pruned, blank lines are set aside. Read-only: nothing in either snapshot changes. Findings are not compared." />
            <ContentControl Style="{StaticResource Hue.Callout.Warn}" Margin="0,12,0,0"
                            Visibility="{Binding Notice, Converter={StaticResource TextToVis}}">
                <TextBlock Text="{views:Masked Notice}" TextWrapping="Wrap" />
            </ContentControl>
        </StackPanel>

        <!-- The pair and the compare, one row: as high as the pickers. What the compare found, problems and hints add a line only when there are any. -->
        <Border Grid.Row="1" Style="{StaticResource Hue.Card}" Padding="14,8" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- The pickers, the status and the actions; when the window is too narrow for all three on one line,
                     the actions move to a line of their own below (FitPairRow), never cut off. -->
                <Grid x:Name="PairRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="A" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedA}" ItemTemplate="{StaticResource SnapshotDate}"
                              IsEnabled="{Binding CanChangePair}" AutomationProperties.Name="Snapshot A"
                              ToolTip="The earlier snapshot, usually" />
                    <Button Grid.Column="2" Content="⇄" Style="{StaticResource Hue.Button.Ghost}" Margin="10,0" Click="OnSwap"
                            IsEnabled="{Binding CanChangePair}" AutomationProperties.Name="Swap A and B" ToolTip="Swap A and B" />
                    <TextBlock Grid.Column="3" Text="B" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Grid.Column="4" VerticalAlignment="Center" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedB}" ItemTemplate="{StaticResource SnapshotDate}"
                              IsEnabled="{Binding CanChangePair}" AutomationProperties.Name="Snapshot B"
                              ToolTip="The later snapshot, usually" />
                    <TextBlock x:Name="PairStatus" Grid.Column="5" Text="{Binding ProgressText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                               Margin="16,0,12,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressText}" />
                    <Border x:Name="ActionsInline" Grid.Column="6" VerticalAlignment="Center">
                    <StackPanel x:Name="PairActions" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ⓘ" FontSize="20" Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,-2,6,0" Cursor="Help"
                                   ToolTip="{Binding PagesText}" AutomationProperties.Name="How pages are compared" />
                        <Button Content="Re-prune A and B" Style="{StaticResource Hue.Button.Ghost}" Margin="0,0,4,0" Click="OnReprunePair"
                                IsEnabled="{Binding CanReprunePair}"
                                ToolTip="Prunes A's and B's saved pages again with the boilerplate groups in effect, then compares again. Writes only their pruned pages; the triage ledger is not touched." />
                        <Button Content="Re-prune all" Style="{StaticResource Hue.Button.Ghost}" Margin="0,0,4,0" Click="OnRepruneAll"
                                IsEnabled="{Binding CanReprune}"
                                ToolTip="Prunes every snapshot of the site again with the boilerplate groups in effect — after a change to the groups, so every comparison sees the same rules. Snapshots whose crawl did not finish are left as they are; the triage ledger is not touched." />
                        <Button Content="Boilerplate groups…" Style="{StaticResource Hue.Button.Ghost}" Margin="0,0,10,0" Click="OnSettings"
                                ToolTip="Settings → Spelling: the boilerplate groups the analysis prunes pages with" />
                        <Button Content="Stop" Style="{StaticResource Hue.Button.Outline}" Margin="0,0,8,0" Click="OnStop"
                                Visibility="{Binding IsComparing, Converter={StaticResource BoolToVis}}" ToolTip="Stops the comparison; nothing is kept" />
                        <Button Content="Compare" Style="{StaticResource Hue.Button.Primary}" Click="OnCompare" IsEnabled="{Binding CanCompare}"
                                ToolTip="Compares every saved file of A with B. Reads only." />
                    </StackPanel>
                    </Border>
                </Grid>
                <Border x:Name="ActionsBelow" Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0" Visibility="Collapsed" />

                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding Summary, Converter={StaticResource TextToVis}}" />
                    <TextBlock Text="{views:Masked PairProblem}" Foreground="{DynamicResource Brush.ErrorText}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding PairProblem, Converter={StaticResource TextToVis}}" />
                    <TextBlock Text="{Binding PairHint}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.WarnText}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding PairHint, Converter={StaticResource TextToVis}}" />
                    <TextBlock Text="{Binding PruneHint}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.WarnText}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding PruneHint, Converter={StaticResource TextToVis}}" />
                </StackPanel>

                <!-- While comparing: a thin bar along the card's bottom edge. -->
                <ProgressBar Grid.RowSpan="3" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="2" VerticalAlignment="Bottom"
                             Margin="-14,0,-14,-8" Visibility="{Binding IsComparing, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- The list and one file, each with the whole height. -->
        <TabControl x:Name="Tabs" Grid.Row="2" Padding="0,10,0,0" Margin="0,12,0,0"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <TabItem x:Name="FilesTab" Header="{Binding FilesTabHeader}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Visibility="{Binding HasListed, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ShownText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Top" Margin="12,4,0,0" />
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding KindChips}" ItemTemplate="{StaticResource FilterChipTemplate}"
                                          ItemsPanel="{StaticResource WrapItems}" Focusable="False" />
                            <Border Width="1" Background="{DynamicResource Brush.LineSoft}" Margin="4,2,12,8" />
                            <ItemsControl ItemsSource="{Binding StateChips}" ItemTemplate="{StaticResource FilterChipTemplate}"
                                          ItemsPanel="{StaticResource WrapItems}" Focusable="False" />
                            <!-- File types: files only, the most frequent first; hidden with only Pages lit. -->
                            <Border Width="1" Background="{DynamicResource Brush.LineSoft}" Margin="4,2,12,8"
                                    Visibility="{Binding ShowTypeChips, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding TypeChips}" ItemTemplate="{StaticResource FilterChipTemplate}"
                                          ItemsPanel="{StaticResource WrapItems}" Focusable="False"
                                          Visibility="{Binding ShowTypeChips, Converter={StaticResource BoolToVis}}" />
                        </WrapPanel>
                    </DockPanel>
                    <ContentControl DockPanel.Dock="Top" Style="{StaticResource Hue.Callout.Ok}" Margin="0,4,0,0"
                                    Visibility="{Binding NothingListed, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Every file of A is in B and identical." TextWrapping="Wrap" />
                    </ContentControl>
                    <!-- The files that are not identical: a click selects (and arms the File tab), a double click or Enter opens. -->
                    <DataGrid x:Name="FileGrid" ItemsSource="{Binding Shown}" SelectedItem="{Binding SelectedFile}" Margin="0,8,0,0"
                              RowHeight="NaN" MinRowHeight="28"
                              MouseDoubleClick="OnFileDoubleClick" PreviewKeyDown="OnFileGridKey"
                              Style="{StaticResource Hue.DataGrid.Compact}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" SelectionMode="Single" AutomationProperties.Name="Files not identical"
                              Visibility="{Binding HasListed, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="State" Width="110" SortMemberPath="State">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding State}" Style="{Binding StateStyle, Converter={x:Static views:HueStyle.Instance}}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="70" />
                            <DataGridTemplateColumn Header="Address" Width="*" SortMemberPath="Address">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="0,3">
                                            <TextBlock Text="{views:Masked Address}" TextTrimming="CharacterEllipsis" ToolTip="{views:Masked Name}" />
                                            <TextBlock Text="{views:Masked Note}" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{views:Masked Note}" Visibility="{Binding Note, Converter={StaticResource TextToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Size in A" Binding="{Binding SizeA}" SortMemberPath="BytesA" Width="90" />
                            <DataGridTextColumn Header="Size in B" Binding="{Binding SizeB}" SortMemberPath="BytesB" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="FileTab" IsEnabled="{Binding Detail.HasFile}">
                <TabItem.Header>
                    <TextBlock Text="{views:Masked Detail.TabHeader}" MaxWidth="520" TextTrimming="CharacterEllipsis" />
                </TabItem.Header>
                <!-- One file, A and B next to each other. -->
                <DockPanel DataContext="{Binding Detail}">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Content="Reference page" Style="{StaticResource Hue.Pill.Accent}" VerticalAlignment="Center" Margin="0,0,8,0"
                                            Visibility="{Binding IsReferencePage, Converter={StaticResource BoolToVis}}"
                                            ToolTip="A reference page of a boilerplate group: the shared parts (header, footer, navigation) are checked here once and kept whole, so the page is compared whole, not pruned — only attribute parts are taken out (Settings → Spelling → Boilerplate groups)." />
                            <ContentControl Content="{Binding State}" Style="{Binding StateStyle, Converter={x:Static views:HueStyle.Instance}}"
                                            VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{views:Masked Address}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       MouseLeftButtonUp="OnOpenAddress" AutomationProperties.Name="Open the live page in the browser">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Heading}">
                                        <Setter Property="ToolTip" Value="{views:Masked Name}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWebAddress}" Value="True">
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="ToolTip" Value="Opens the live page in your browser — the site as it is now, not either snapshot" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsWebAddress}" Value="True" />
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="TextDecorations" Value="Underline" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="‹ Back to list" Style="{StaticResource Hue.Button.Ghost}" Margin="0,0,12,6" Click="OnBackToList"
                                    ToolTip="Back to the list (Esc, or the mouse's back button)" />
                            <Button Content="‹ Previous file" Style="{StaticResource Hue.Button.Outline}" Margin="0,0,6,6" Click="OnPreviousFile"
                                    IsEnabled="{Binding DataContext.CanPreviousFile, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock Text="{Binding DataContext.Position, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Text.Caption}"
                                       VerticalAlignment="Center" Margin="2,0,8,6" />
                            <Button Content="Next file ›" Style="{StaticResource Hue.Button.Outline}" Margin="0,0,18,6" Click="OnNextFile"
                                    IsEnabled="{Binding DataContext.CanNextFile, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Content="↑ Previous change" Style="{StaticResource Hue.Button.Tonal}" Margin="0,0,6,6" Click="OnPreviousChange"
                                    IsEnabled="{Binding HasDifferences}" ToolTip="Previous change in this file (Shift+F8)" />
                            <Button Content="↓ Next change" Style="{StaticResource Hue.Button.Tonal}" Margin="0,0,8,6" Click="OnNextChange"
                                    IsEnabled="{Binding HasDifferences}" ToolTip="Next change in this file (F8)" />
                            <TextBlock Text="{Binding DifferenceText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,18,6" />
                            <CheckBox Content="100 %" IsChecked="{Binding ActualSize}" VerticalAlignment="Center" Margin="0,0,18,6"
                                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"
                                      ToolTip="The pictures at their own pixels, scrolling together — off: fitted to the space" />
                            <CheckBox Content="All lines" IsChecked="{Binding AllLines}" VerticalAlignment="Center" Margin="0,0,14,6"
                                      Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"
                                      ToolTip="Every line, not only the changes with a few lines around them" />
                            <CheckBox Content="As saved" IsChecked="{Binding AsSaved}" VerticalAlignment="Center" Margin="0,0,18,6"
                                      Visibility="{Binding IsPage, Converter={StaticResource BoolToVis}}"
                                      ToolTip="The page as it was saved, not as its run pruned it" />
                            <Button Content="Show A in folder" Style="{StaticResource Hue.Button.Ghost}" Margin="0,0,6,6" Click="OnRevealA"
                                    IsEnabled="{Binding CanRevealA}" ToolTip="Shows the file in Explorer without opening it (a page opened in a browser would load from the live site)" />
                            <Button Content="Show B in folder" Style="{StaticResource Hue.Button.Ghost}" Margin="0,0,0,6" Click="OnRevealB"
                                    IsEnabled="{Binding CanRevealB}" ToolTip="Shows the file in Explorer without opening it (a page opened in a browser would load from the live site)" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Counts}" Style="{StaticResource Text.Caption}" Margin="0,2,0,6"
                                   Visibility="{Binding Counts, Converter={StaticResource TextToVis}}" />
                        <ContentControl Style="{StaticResource Hue.Callout}" Margin="0,0,0,8"
                                        Visibility="{Binding HasCrawlNote, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{views:Masked CrawlNote}" TextWrapping="Wrap" />
                        </ContentControl>
                        <ContentControl Style="{StaticResource Hue.Callout.Warn}" Margin="0,0,0,8"
                                        Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{views:Masked Note}" TextWrapping="Wrap" />
                        </ContentControl>
                        <ContentControl Style="{StaticResource Hue.Callout.Critical}" Margin="0,0,0,8"
                                        Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{views:Masked Problem}" TextWrapping="Wrap" />
                        </ContentControl>
                        <TextBlock Text="Loading …" Style="{StaticResource Text.Caption}" Margin="0,0,0,8"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- A file that is not text (a picture aside): size and checksum of each side. -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource Hue.Card}" Visibility="{Binding ShowChecksums, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="A" Style="{StaticResource Text.Heading}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SizeA}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding HashA}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="B" Style="{StaticResource Text.Heading}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeB}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding HashB}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                                       Text="SHA-256 of each side. The same checksum means the same bytes." />
                        </Grid>
                    </Border>

                    <Grid>
                    <!-- A PDF: what differs inside it — a table of A and B, then the parts only one side has. -->
                    <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasPdf, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource Hue.Card}">
                            <StackPanel>
                                <TextBlock Text="Inside the PDF" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding PdfLines}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Visibility="{Binding HasPdfRows, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" Margin="8,0,8,4">
                                        <Run Text="A · " /><Run Text="{Binding DataContext.ResultA.Label, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Margin="8,0,8,4">
                                        <Run Text="B · " /><Run Text="{Binding DataContext.ResultB.Label, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </TextBlock>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PdfRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="0,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Differs}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextDim}" Margin="8,0" />
                                                    <TextBlock Grid.Column="1" Text="{views:Masked A}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="8,0"
                                                               ToolTip="{Binding TipA}" />
                                                    <TextBlock Grid.Column="2" Text="{views:Masked B}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="8,0"
                                                               ToolTip="{Binding TipB}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Parts only one side has" Style="{StaticResource Text.Section}" Margin="0,14,0,6"
                                           Visibility="{Binding HasPdfParts, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding PdfParts}" Focusable="False" Visibility="{Binding HasPdfParts, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Content="{Binding Side}" Style="{Binding SideStyle, Converter={x:Static views:HueStyle.Instance}}"
                                                                VerticalAlignment="Top" Margin="0,0,10,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource Text.Body}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Text.Caption}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <TextBlock Grid.Column="3" Text="{views:Masked Text}" Style="{StaticResource Text.Mono}" FontSize="11" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding PdfPartsMore}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                           Visibility="{Binding PdfPartsMore, Converter={StaticResource TextToVis}}" />

                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Text="Every object and stream unpacked and compared, apart from how the file lays them out: object numbers, the cross-reference table, font subset tags and the stamps (dates, producer, creator, file ID, XMP) are set aside. Page content shows its first readable characters." />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                    <!-- A and B as pictures, next to each other. -->
                    <Grid Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="A · " Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                                <ContentControl Content="{Binding DataContext.ResultA, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ContentTemplate="{StaticResource SnapshotDate}" Focusable="False" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding PictureTextA}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       ToolTip="{Binding PictureHashA, StringFormat='SHA-256 {0}'}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="B · " Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                                <ContentControl Content="{Binding DataContext.ResultB, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ContentTemplate="{StaticResource SnapshotDate}" Focusable="False" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding PictureTextB}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       ToolTip="{Binding PictureHashB, StringFormat='SHA-256 {0}'}" />
                        </StackPanel>
                        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Checker}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                            <Grid>
                                <ScrollViewer x:Name="PictureScrollA" Style="{StaticResource PictureScroll}" ScrollChanged="OnPictureScrolled">
                                    <Image Source="{Binding PictureA}" Style="{StaticResource PictureA}" AutomationProperties.Name="Picture in A" />
                                </ScrollViewer>
                                <TextBlock Text="{Binding PictureTextA}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                           Visibility="{Binding NoPictureA, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource Checker}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                            <Grid>
                                <ScrollViewer x:Name="PictureScrollB" Style="{StaticResource PictureScroll}" ScrollChanged="OnPictureScrolled">
                                    <Image Source="{Binding PictureB}" Style="{StaticResource PictureB}" AutomationProperties.Name="Picture in B" />
                                </ScrollViewer>
                                <TextBlock Text="{Binding PictureTextB}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                           Visibility="{Binding NoPictureB, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- A and B as text: line numbers and lines; what differs is marked. -->
                    <Grid Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- An SVG file drawn above its text: A's and B's, B's compared with A's. -->
                        <Grid Grid.Row="1" Margin="54,0,18,6" Visibility="{Binding HasDrawings, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding DrawingsA}" ItemTemplate="{StaticResource EmbeddedPicture}" Focusable="False" />
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding DrawingsB}" ItemTemplate="{StaticResource EmbeddedPicture}" Focusable="False" />
                        </Grid>
                        <Grid Grid.Row="0" Margin="0,0,18,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="54,0,0,0">
                                <TextBlock Text="A · " Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                                <ContentControl Content="{Binding DataContext.ResultA, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ContentTemplate="{StaticResource SnapshotDate}" Focusable="False" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="54,0,0,0">
                                <TextBlock Text="B · " Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                                <ContentControl Content="{Binding DataContext.ResultB, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ContentTemplate="{StaticResource SnapshotDate}" Focusable="False" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="RowList" Grid.Row="2" ItemsSource="{Binding Rows}" ItemContainerStyle="{StaticResource DiffRow}"
                                 FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="A and B, line by line">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding LineA}" Style="{StaticResource LineNumber}" />
                                        <Border Grid.Column="1" Style="{StaticResource CellA}">
                                            <StackPanel>
                                                <TextBlock views:Highlight.RemovedPieces="{Binding PiecesA}" TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding PicturesA}" ItemTemplate="{StaticResource EmbeddedPicture}" Focusable="False"
                                                              Visibility="{Binding HasPicturesA, Converter={StaticResource BoolToVis}}" />
                                                <CheckBox Content="Show the base64 text" IsChecked="{Binding ShowBase64}" Margin="0,4,0,2" FontFamily="{StaticResource Font.Ui}"
                                                          Visibility="{Binding HasPicturesA, Converter={StaticResource BoolToVis}}"
                                                          ToolTip="The picture stands in the source as base64 text; unfold it to see that text, its differences marked." />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{DynamicResource Brush.LineSoft}" />
                                        <TextBlock Grid.Column="3" Text="{Binding LineB}" Style="{StaticResource LineNumber}" />
                                        <Border Grid.Column="4" Style="{StaticResource CellB}">
                                            <StackPanel>
                                                <TextBlock views:Highlight.AddedPieces="{Binding PiecesB}" TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding PicturesB}" ItemTemplate="{StaticResource EmbeddedPicture}" Focusable="False"
                                                              Visibility="{Binding HasPicturesB, Converter={StaticResource BoolToVis}}" />
                                                <CheckBox Content="Show the base64 text" IsChecked="{Binding ShowBase64}" Margin="0,4,0,2" FontFamily="{StaticResource Font.Ui}"
                                                          Visibility="{Binding HasPicturesB, Converter={StaticResource BoolToVis}}"
                                                          ToolTip="The picture stands in the source as base64 text; unfold it to see that text, its differences marked." />
                                            </StackPanel>
                                        </Border>
                                        <!-- Unchanged lines folded away. -->
                                        <Border Grid.ColumnSpan="5" Background="{DynamicResource Brush.Raised}" Padding="54,2,6,2"
                                                Visibility="{Binding IsGap, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding GapText, StringFormat='⋯ {0}'}" Foreground="{DynamicResource Brush.TextMuted}"
                                                       FontFamily="{StaticResource Font.Ui}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
