<UserControl x:Class="CrawlerSuite.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CrawlerSuite.Views"
             xmlns:run="clr-namespace:CrawlerSuite.Run"
             views:UrlDisplay.Root="{Binding SiteRoot}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:PresentToPillStyle x:Key="PresentPill" />
        <views:TextToVisibility x:Key="TextToVis" />

        <!-- Numbers right-aligned with tabular digits. -->
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A tab header: title, then its count; empty tabs stay but are dimmed. -->
        <DataTemplate x:Key="TabHeader">
            <StackPanel x:Name="Root" Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" />
                <TextBlock Text="{Binding CountText}" Margin="7,0,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The theme's tab control, whose row of tabs folds away while the Results page has its tab
             rows folded (ResultsModel.TabsOpen): only the content stays. -->
        <Style x:Key="FoldableTabs" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="HeaderBorder" BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="0,0,0,1">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Panel.ZIndex="1"
                                          KeyboardNavigation.TabIndex="1" Background="Transparent" />
                            </Border>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.TabsOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter TargetName="HeaderBorder" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PART_SelectedContentHost" Property="Margin" Value="0" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A group: an optional note, then a row of further tabs (recursion through the implicit templates). -->
        <DataTemplate DataType="{x:Type run:FindingBranchVm}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- The group's note folds with the tab rows it belongs to. -->
                <Border Visibility="{Binding DataContext.TabsOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"
                               Visibility="{Binding Note, Converter={StaticResource TextToVis}}" />
                </Border>
                <TabControl Grid.Row="1" ItemsSource="{Binding Children}" ItemTemplate="{StaticResource TabHeader}"
                            SelectedItem="{Binding SelectedChild, Mode=TwoWay}" Style="{StaticResource FoldableTabs}" />
            </Grid>
        </DataTemplate>

        <!-- A findings table. -->
        <DataTemplate DataType="{x:Type run:FindingLeafVm}">
            <views:FindingTableView />
        </DataTemplate>

        <!-- Every output file of the snapshot. -->
        <DataTemplate DataType="{x:Type run:FilesTabVm}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" Margin="0,0,0,10" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}"
                          Style="{StaticResource Hue.DataGrid.Compact}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" MouseDoubleClick="OnRowDoubleClick"
                          AutomationProperties.Name="Output files of the snapshot">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Section}" Margin="4,14,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="44" />
                        <DataGridTextColumn Header="Output" Binding="{Binding Title}" Width="260" />
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding PresentText}" Style="{Binding Present, Converter={StaticResource PresentPill}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Rows" Binding="{Binding Rows}" Width="90"
                                            ElementStyle="{StaticResource NumberCell}" HeaderTemplate="{x:Static views:Headers.RightAligned}" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100"
                                            ElementStyle="{StaticResource NumberCell}" HeaderTemplate="{x:Static views:Headers.RightAligned}" />
                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="300" />
                        <DataGridTextColumn Header="Note" Binding="{views:Masked Note}" SortMemberPath="Note" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{views:Masked Heading}" Style="{StaticResource Text.Heading}" />
                <TextBlock Text="{views:Masked Subheading}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                <TextBlock Text="{views:Masked SnapshotPath}" Style="{StaticResource Text.Mono}" Margin="0,4,0,0"
                           Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <!-- Always masked at the strictest level: the copy never carries the target. -->
                <Button x:Name="CopyCountsButton" Content="Copy for AI" Style="{StaticResource Hue.Button.Tonal}" Margin="0,0,10,0"
                        Click="OnCopyCountsForAi" IsEnabled="{Binding HasSnapshot}"
                        ToolTip="Copies every Results tab with its count as text, with site names, URLs and paths hidden — whatever the screen mask is set to." />
                <Button Content="Choose snapshot…" Style="{StaticResource Hue.Button.Outline}" Click="OnChooseSnapshot" />
                <Button Content="Open snapshot folder" Style="{StaticResource Hue.Button.Tonal}" Margin="10,0,0,0"
                        Click="OnOpenFolder" IsEnabled="{Binding HasSnapshot}" />
            </StackPanel>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Warnings}" Margin="0,16,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentControl Style="{StaticResource Hue.Callout.Warn}" Margin="0,0,0,8">
                        <TextBlock Text="{views:Masked}" TextWrapping="Wrap" />
                    </ContentControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2" Margin="0,8,0,0" Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Folds the tab rows out of the way once a tab is picked; folded, it names the tab on screen. -->
            <ToggleButton Style="{StaticResource Hue.ExpanderHeader}" HorizontalAlignment="Left" Margin="-12,0,0,0"
                          IsChecked="{Binding TabsOpen, Mode=TwoWay}" Content="{Binding TabToggleText}"
                          AutomationProperties.Name="Show or fold the tab rows" />
            <TabControl Grid.Row="1" ItemsSource="{Binding Tabs}" ItemTemplate="{StaticResource TabHeader}"
                        SelectedItem="{Binding SelectedTab, Mode=TwoWay}" Style="{StaticResource FoldableTabs}"
                        AutomationProperties.Name="Findings" />
        </Grid>
    </Grid>
</UserControl>
