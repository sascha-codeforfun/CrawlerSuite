<UserControl x:Class="CrawlerSuite.Views.OutputFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CrawlerSuite.Views">
    <Grid Margin="28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- All output files, grouped by topic. -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Output files" Style="{StaticResource Text.Heading}" />
                <TextBlock Text="What every file a crawl writes is for, and its exact format. This is the format contract shared with the console version."
                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
            <ListBox x:Name="FileList" ItemsSource="{Binding Formats}" SelectedItem="{Binding Selected}"
                     AutomationProperties.Name="Output files">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Section}" Margin="4,12,0,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock Style="{StaticResource Text.Body}">
                                <Run Text="{Binding Number, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                                <Run Text="  " />
                                <Run Text="{Binding Title, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding PrimaryFileName}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- The selected file's description. -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" />
                <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Mono}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Purpose}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,12,0,0" />

                <Border Style="{StaticResource Hue.Card}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Written by" Style="{StaticResource Text.Caption}" Margin="0,3" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WrittenBy}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,3" />
                        <TextBlock Grid.Row="1" Text="Written when" Style="{StaticResource Text.Caption}" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WrittenWhen}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,3" />
                        <TextBlock Grid.Row="2" Text="Delimiter" Style="{StaticResource Text.Caption}" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Delimiter}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,3" />
                        <TextBlock Grid.Row="3" Text="Header row" Style="{StaticResource Text.Caption}" Margin="0,3" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Text.Body}" Margin="0,3">
                            <TextBlock.Text>
                                <Binding Path="HeaderRow" Converter="{x:Static local:YesNo.Instance}" />
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Row="4" Text="Encoding" Style="{StaticResource Text.Caption}" Margin="0,3" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Encoding}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,3" />
                        <TextBlock Grid.Row="5" Text="Quoting" Style="{StaticResource Text.Caption}" Margin="0,3" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Quoting}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,3" />
                        <TextBlock Grid.Row="6" Text="Format version" Style="{StaticResource Text.Caption}" Margin="0,3" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding FormatVersion}" Style="{StaticResource Text.Body}" Margin="0,3" />
                    </Grid>
                </Border>

                <TextBlock Text="COLUMNS" Style="{StaticResource Text.Section}" Margin="0,20,0,8" />
                <DataGrid ItemsSource="{Binding Columns}" Style="{StaticResource Hue.DataGrid.Compact}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                          AutomationProperties.Name="Columns of the selected file">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Column" Binding="{Binding Name}" Width="240" />
                        <DataGridTextColumn Header="Meaning" Binding="{Binding Meaning}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="READ BY" Style="{StaticResource Text.Section}" Margin="0,20,0,8" />
                <ItemsControl ItemsSource="{Binding ReadBy}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="NOTES" Style="{StaticResource Text.Section}" Margin="0,20,0,8" />
                <TextBlock Text="{Binding Notes}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
